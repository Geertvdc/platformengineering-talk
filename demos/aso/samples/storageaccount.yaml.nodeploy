apiVersion: storage.azure.com/v1api20210401
kind: StorageAccount
metadata:
  name: azurefestbe26
  namespace: aso-demo
spec:
  location: westeurope
  kind: StorageV2
  owner:
    # armId lets ASO manage a resource inside a pre-existing (non-ASO-managed) RG.
    armId: /subscriptions/b8affb75-1fd8-4116-8065-dc871fdbe8bc/resourceGroups/aso-demo-rg
  sku:
    name: Standard_LRS
  accessTier: Hot
  minimumTlsVersion: TLS1_2
  allowBlobPublicAccess: false
